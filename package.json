{
  "name": "recompone-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "test:fitness": "node --test tests/fitness/*.test.js",
    "test:security": "node --test tests/security/*.test.js",
    "test:contract": "node --test tests/contract/*.test.js",
    "test:e2e": "playwright test --grep-invert @deployed",
    "test:e2e:deployed": "playwright test --grep @deployed",
    "verify:android": "node scripts/verify-android-release.mjs",
    "verify:android:live": "node scripts/verify-android-release.mjs --live",
    "verify:android:aab": "node scripts/verify-android-release.mjs --live --aab",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.48",
    "@base44/vite-plugin": "^1.0.36",
    "@radix-ui/react-alert-dialog": "^1.1.23",
