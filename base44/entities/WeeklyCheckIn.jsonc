{
  "name": "WeeklyCheckIn",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "avg_weight_current": {
      "type": "number"
    },
    "avg_weight_previous": {
      "type": "number"
    },
    "weight_change": {
      "type": "number"
    },
    "calorie_adherence": {
      "type": "number"
    },
    "protein_adherence": {
      "type": "number"
    },
    "step_adherence": {
      "type": "number"
    },
    "workout_adherence": {
      "type": "number"
    },
    "hunger_average": {
      "type": "number"
    },
    "energy_average": {
      "type": "number"
    },
    "sleep_average": {
      "type": "number"
    },
    "recommendation_decision": {
      "type": "string",
      "enum": [
        "keep_plan",
        "reduce_calories",
        "increase_calories",
        "increase_steps",
        "focus_on_adherence",
        "reduce_training_fatigue",
        "seek_professional_guidance",
        "keep_collecting_data",
        "keep_plan_possible_recomp",
        "keep_plan_possible_recomp_or_water",
        "keep_plan_and_monitor"
      ]
    },
    "ai_summary": {
      "type": "string"
    },
    "targets_for_next_week": {
      "type": "object",
      "description": "Snapshot of the strategy recommended for next week."
    },
    "period_key": {
      "type": "string",
      "maxLength": 40,
      "description": "Weekly Check-In v2: the local period, start_date:end_date. One non-superseded check-in stands for each period."
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "applied", "declined", "acknowledged", "superseded"],
      "description": "proposed while an apply is in flight; applied, declined (kept or customized instead), acknowledged (nothing to change) or superseded (the plan changed before the apply finished)."
    },
    "user_decision": {
      "type": "string",
      "enum": ["apply", "keep_current", "customize"]
    },
    "previous_targets": {
      "type": "object",
      "description": "Snapshot of the targets the proposal was made against."
    },
    "supporting_metrics": {
      "type": "object",
      "description": "Normalized metrics and confidence inputs behind the proposal."
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "decision_reason": {
      "type": "string",
      "maxLength": 1000
    },
    "rule_version": {
      "type": "string",
      "maxLength": 40
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "start_date",
    "end_date",
    "recommendation_decision",
    "ai_summary"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}