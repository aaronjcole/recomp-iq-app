{
  "name": "DailyLog",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Log date (YYYY-MM-DD). One record per day per user."
    },
    "weight_lbs": {
      "type": "number"
    },
    "calories": {
      "type": "number"
    },
    "protein_g": {
      "type": "number"
    },
    "carbs_g": {
      "type": "number"
    },
    "fat_g": {
      "type": "number"
    },
    "steps": {
      "type": "number"
    },
    "workout_completed": {
      "type": "boolean"
    },
    "workout_type": {
      "type": "string"
    },
    "waist_in": {
      "type": "number"
    },
    "water_oz": {
      "type": "number",
      "description": "Daily water intake in ounces."
    },
    "hunger_rating": {
      "type": "number",
      "description": "1-5"
    },
    "energy_rating": {
      "type": "number",
      "description": "1-5"
    },
    "sleep_hours": {
      "type": "number"
    },
    "sleep_quality": {
      "type": "number",
      "description": "1-5"
    },
    "soreness_rating": {
      "type": "number",
      "description": "1-5"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}