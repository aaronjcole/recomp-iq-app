{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "age": {
      "type": "number",
      "minimum": 18,
      "maximum": 120
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "unspecified"
      ]
    },
    "height_in": {
      "type": "number",
      "minimum": 36,
      "maximum": 108,
      "description": "Height in inches"
    },
    "current_weight_lbs": {
      "type": "number",
      "minimum": 40,
      "maximum": 1200,
      "description": "Current weight in pounds"
    },
    "goal_weight_lbs": {
      "type": "number",
      "minimum": 40,
      "maximum": 1200,
      "description": "Target weight in pounds"
    },
    "goal": {
      "type": "string",
      "enum": [
        "fat_loss_biased_recomp",
        "body_recomposition",
        "fat_loss",
        "aggressive_fat_loss",
        "muscle_gain",
        "lean_bulk",
        "aggressive_gain",
        "maintenance",
        "strength_retention_cut"
      ]
    },
    "training_days_per_week": {
      "type": "number",
      "minimum": 0,
      "maximum": 7
    },
    "cardio_days_per_week": {
      "type": "number",
      "minimum": 0,
      "maximum": 7
    },
    "job_activity": {
      "type": "string",
      "enum": [
        "sedentary",
        "lightly_active",
        "moderately_active",
        "very_active",
        "extremely_active"
      ]
    },
    "average_steps": {
      "type": "number",
      "minimum": 0,
      "maximum": 200000
    },
    "experience_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "primary_concern": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "age",
    "sex",
    "height_in",
    "current_weight_lbs",
    "goal",
    "training_days_per_week",
    "cardio_days_per_week",
    "job_activity",
    "average_steps",
    "experience_level"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}