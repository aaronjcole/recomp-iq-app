{
  "name": "AiContentReport",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Authenticated user who submitted the report. Set only by the backend function."
    },
    "message_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Opaque identifier returned with the AI response. User prompts and health context are not stored here."
    },
    "category": {
      "type": "string",
      "enum": [
        "unsafe_health_advice",
        "harmful_or_offensive",
        "incorrect_or_misleading",
        "other"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "reported_content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "AI reply snapshot only. User prompts and health-record context must not be stored."
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "reviewing",
        "resolved",
        "dismissed"
      ],
      "default": "received"
    }
  },
  "required": [
    "owner_id",
    "message_id",
    "category",
    "reported_content",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}