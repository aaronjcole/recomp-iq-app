{
  "name": "Recipe",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "nutrition_basis": {
      "type": "string",
      "enum": ["batch"],
      "description": "Batch nutrition is authoritative; absent nutrients are unknown, not zero."
    },
    "batch_nutrition": {
      "type": "object",
      "description": "Explicit nutrition totals for the entire recipe. Divide by servings for one portion. Omit unknown values.",
      "properties": {
        "calories": { "type": "number", "minimum": 0, "maximum": 100000 },
        "protein_g": { "type": "number", "minimum": 0, "maximum": 10000 },
        "carbs_g": { "type": "number", "minimum": 0, "maximum": 15000 },
        "fat_g": { "type": "number", "minimum": 0, "maximum": 10000 },
        "fiber_g": { "type": "number", "minimum": 0, "maximum": 10000 }
      }
    },
    "source_url": {
      "type": "string"
    },
    "servings": {
      "type": "number",
      "minimum": 1,
      "maximum": 1000
    },
    "ingredients": {
      "type": "array",
      "description": "List of ingredients with quantity, unit, and optional nutrition estimates.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          "unit": {
            "type": "string"
          },
          "grams_estimate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "calories": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          "protein_g": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "carbs_g": {
            "type": "number",
            "minimum": 0,
            "maximum": 15000
          },
          "fat_g": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "fiber_g": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "name",
          "quantity",
          "unit"
        ]
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calories_per_serving": {
      "type": "number"
    },
    "protein_g_per_serving": {
      "type": "number"
    },
    "carbs_g_per_serving": {
      "type": "number"
    },
    "fat_g_per_serving": {
      "type": "number"
    },
    "fiber_g_per_serving": {
      "type": "number"
    },
    "prep_minutes": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "servings",
    "ingredients",
    "tags"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
