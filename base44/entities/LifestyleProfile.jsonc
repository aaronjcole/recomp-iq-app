{
  "name": "LifestyleProfile",
  "type": "object",
  "properties": {
    "typical_schedule": {
      "type": "string",
      "maxLength": 2000,
      "description": "User's typical daily schedule as described to the coach"
    },
    "typical_meals": {
      "type": "string",
      "maxLength": 2000,
      "description": "What the user usually eats in a day"
    },
    "dietary_restrictions": {
      "type": "array",
      "description": "Array of restriction strings e.g. ['gluten-free', 'no red meat']"
    },
    "activity_description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Qualitative activity level beyond tracked workouts"
    },
    "lifestyle_notes": {
      "type": "string",
      "maxLength": 2000,
      "description": "Any other context the coach has gathered over time"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
