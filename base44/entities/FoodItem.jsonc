{
  "name": "FoodItem",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "usda_fdc",
        "branded",
        "restaurant",
        "recipe"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "brand_name": {
      "type": "string"
    },
    "serving_description": {
      "type": "string"
    },
    "serving_grams": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "calories": {
      "type": "number",
      "minimum": 0,
      "maximum": 20000
    },
    "protein_g": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000
    },
    "carbs_g": {
      "type": "number",
      "minimum": 0,
      "maximum": 3000
    },
    "fat_g": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000
    },
    "fiber_g": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000
    },
    "added_sugar_g": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000
    },
    "saturated_fat_g": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000
    },
    "sodium_mg": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "source",
    "name",
    "serving_description",
    "calories",
    "protein_g",
    "carbs_g",
    "fat_g"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}