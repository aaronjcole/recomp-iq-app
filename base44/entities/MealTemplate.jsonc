{
  "name": "MealTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "serving_description": {
            "type": "string"
          },
          "calories": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "protein_g": {
            "type": "number",
            "minimum": 0,
            "maximum": 2000
          },
          "carbs_g": {
            "type": "number",
            "minimum": 0,
            "maximum": 3000
          },
          "fat_g": {
            "type": "number",
            "minimum": 0,
            "maximum": 2000
          }
        },
        "required": [
          "name",
          "calories",
          "protein_g",
          "carbs_g",
          "fat_g"
        ]
      }
    },
    "total_calories": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "total_protein_g": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    },
    "total_carbs_g": {
      "type": "number",
      "minimum": 0,
      "maximum": 15000
    },
    "total_fat_g": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "items",
    "total_calories",
    "total_protein_g",
    "total_carbs_g",
    "total_fat_g"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
